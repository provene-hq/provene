{
  "id": "001-governing-rule",
  "rfc": "0002",
  "section": "5.1",
  "description": "First match in document order governs each path. docs-are-relaxed must precede everything-else or the catch-all wins.",
  "input": {
    "policy": {
      "version": 1,
      "mode": "required-with-exemptions",
      "defaults": {
        "minTier": "T2",
        "attributionGranularity": "file"
      },
      "exemptions": [
        {
          "id": "dependabot",
          "reason": "Automated dependency bumps carry no agent session.",
          "author": "dependabot[bot]"
        }
      ],
      "rules": [
        {
          "id": "docs-are-relaxed",
          "paths": [
            "docs/**",
            "**/*.md"
          ],
          "action": "allow"
        },
        {
          "id": "crypto-needs-human",
          "paths": [
            "src/crypto/**"
          ],
          "when": {
            "agentAttributed": true
          },
          "require": {
            "humanApproval": true,
            "receipt": {
              "minTier": "T2"
            }
          },
          "action": "block",
          "message": "Agent-authored changes under src/crypto/ require a human approver.",
          "remedy": "Request review from @acme/security, then re-run this check."
        },
        {
          "id": "everything-else",
          "paths": [
            "**"
          ],
          "require": {
            "receipt": {
              "minTier": "T2"
            },
            "tests": {
              "result": "PASSED",
              "observedBy": "ci",
              "baseIsMergeBase": true
            }
          },
          "action": "block",
          "message": "Changes must carry CI-observed test evidence.",
          "remedy": "Add tests covering the changed files."
        }
      ]
    },
    "changedPaths": [
      "docs/guide.md",
      "README.md",
      "src/crypto/aes.ts",
      "src/auth/session.ts"
    ]
  },
  "expect": {
    "governing": {
      "docs/guide.md": "docs-are-relaxed",
      "README.md": "docs-are-relaxed",
      "src/crypto/aes.ts": "crypto-needs-human",
      "src/auth/session.ts": "everything-else"
    }
  }
}
