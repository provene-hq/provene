node_modules/
dist/
*.tsbuildinfo
.DS_Store
Thumbs.db
*.log

# NOTE: .provene/ is deliberately NOT ignored. Receipts are committed in-tree —
# that is the whole design (RFC 0001 section 8). Adding one here would silently
# disable the product in its own repository.

# Business strategy, pricing, gate criteria, competitive analysis and review
# correspondence. Not for a public repository. The THREAT MODEL is public and
# lives at spec/threat-model.md — publishing that builds trust; publishing your
# kill gates and pricing does not.
planning/

# Coverage reports are build output.
packages/cli/coverage/

# Sample receipts generated for schema validation.
.samples/

# Output paths the flag-acceptance test used to write here. It writes to a
# scratch directory now; these remain so a stray manual run cannot repeat the
# commit that put them in a public repository.
o.json
m

# Local secrets. Never tracked, never suggested as a place to look. This file
# is untracked by default, which is not the same as safe: `git add -A` is how
# scratch files reached this public repository once already, and the next one
# would be an API key.
.env
.env.*
!.env.example

# Scratch scripts an agent left in the repository root while probing another
# agent. Committed once by a `git add -A` that assumed the working tree was
# mine. Ignored so the same accident cannot repeat.
/extract*.py
/fail.js
/pass.js
/old.js
/delete-me.js
/rename-me.js
/renamed.js
