{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provene.dev/schema/policy/v1.json",
  "title": "Provene Policy v1",
  "description": "Schema for .provene/policy.yml (RFC 0002). Unknown keys are REJECTED everywhere: a security control that silently ignores a misspelled requirement reports green while enforcing nothing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mode", "rules"],
  "properties": {
    "version": { "const": 1 },
    "mode": { "enum": ["conditional", "required-with-exemptions", "enrolled"] },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minTier": { "$ref": "#/$defs/tier" },
        "attributionGranularity": { "enum": ["file", "hunk"] }
      }
    },
    "implicit": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "policySelfProtection": { "type": "boolean", "default": true } }
    },
    "exemptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "reason": { "type": "string", "minLength": 1, "description": "Prose. Appears in check output; recorded in the aggregate receipt." },
          "author": { "type": "string" },
          "committer": { "type": "string" },
          "messageMatches": { "type": "string", "format": "regex" }
        },
        "anyOf": [
          { "required": ["author"] },
          { "required": ["committer"] },
          { "required": ["messageMatches"] }
        ]
      }
    },
    "enrollment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": { "enum": ["file", "api"] },
        "path": { "type": "string" }
      },
      "if": { "properties": { "source": { "const": "file" } }, "required": ["source"] },
      "then": { "required": ["path"] }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "paths", "action"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "action": { "enum": ["block", "warn", "allow"] },
          "message": { "type": "string", "minLength": 1 },
          "remedy": { "type": "string", "minLength": 1 },
          "when": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "agentAttributed": { "type": "boolean" },
              "agent": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "tool": { "type": "array", "items": { "type": "string" } },
                  "model": { "type": "array", "items": { "type": "string" } }
                }
              },
              "changedLines": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "min": { "type": "integer", "minimum": 0 },
                  "max": { "type": "integer", "minimum": 0 }
                }
              }
            }
          },
          "require": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "receipt": {
                "oneOf": [
                  { "type": "boolean" },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "minTier": { "$ref": "#/$defs/tier" },
                      "attributionGranularity": { "enum": ["file", "hunk"] }
                    }
                  }
                ]
              },
              "tests": {
                "oneOf": [
                  { "type": "boolean" },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "result": { "enum": ["PASSED", "WARNED"] },
                      "observedBy": { "enum": ["ci", "local"] },
                      "baseIsMergeBase": { "type": "boolean" }
                    }
                  }
                ]
              },
              "checks": { "type": "array", "items": { "enum": ["lint", "typecheck", "build", "check"] } },
              "unattributedPaths": {
                "type": "object",
                "additionalProperties": false,
                "required": ["max"],
                "properties": { "max": { "type": "integer", "minimum": 0 } }
              },
              "humanApproval": { "type": "boolean" },
              "agent": {
                "type": "object",
                "additionalProperties": false,
                "properties": { "allowed": { "type": "array", "items": { "type": "string" } } }
              },
              "model": {
                "type": "object",
                "additionalProperties": false,
                "properties": { "allowed": { "type": "array", "items": { "type": "string" } } }
              },
              "trustRoot": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "allowed": { "type": "array", "items": { "enum": ["sigstore-public", "sigstore-private", "ssh", "x509"] } }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "comment": "RFC 0002 section 6: block rules must carry a remedy, and block/warn must carry a message.",
            "if": { "properties": { "action": { "const": "block" } }, "required": ["action"] },
            "then": { "required": ["require", "message", "remedy"] }
          },
          {
            "if": { "properties": { "action": { "const": "warn" } }, "required": ["action"] },
            "then": { "required": ["require", "message"] }
          }
        ]
      }
    }
  },
  "$defs": {
    "tier": { "enum": ["T0", "T1", "T2", "T3"] },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" }
  }
}
