{
  "name": "proveneio",
  "version": "0.0.6",
  "description": "Portable, signed evidence receipts for AI-generated code changes",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "provene": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.6"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "conformance": "node --test test/conformance.test.ts",
    "prepublishOnly": "npm run build",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-reporter=spec --test-reporter-destination=stdout 'test/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "provenance",
    "attestation",
    "ai",
    "agent",
    "code-review",
    "supply-chain",
    "in-toto",
    "sigstore",
    "receipts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/provene-hq/provene.git"
  },
  "homepage": "https://github.com/provene-hq/provene#readme",
  "bugs": {
    "url": "https://github.com/provene-hq/provene/issues"
  }
}
